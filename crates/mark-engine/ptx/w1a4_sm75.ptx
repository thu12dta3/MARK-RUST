    mov.u32 %r3, %ctaid.x;
    mov.u32 %r4, %ntid.x;
    mov.u32 %r5, %tid.x;
    mad.lo.u32 %r6, %r3, %r4, %r5;
    setp.ge.u32 %p1, %r6, %r2;
    @%p1 bra DONE;

    mul.lo.u32 %r7, %r6, %r1;
    mul.wide.u32 %rd6, %r7, 8;
    add.u64 %rd7, %rd1, %rd6;

    mov.f32 %f1, 0f00000000;
    mov.u32 %r8, 0;

LOOP_B:
    setp.ge.u32 %p2, %r8, %r1;
    @%p2 bra END_LOOP;

    mul.wide.u32 %rd8, %r8, 8;
    add.u64 %rd9, %rd7, %rd8;
    ld.global.u64 %rd10, [%rd9];

    mul.wide.u32 %rd11, %r8, 32;
    add.u64 %rd12, %rd2, %rd11;
    ld.global.u64 %rd13, [%rd12];
    ld.global.u64 %rd14, [%rd12 + 8];
    ld.global.u64 %rd15, [%rd12 + 16];
    ld.global.u64 %rd16, [%rd12 + 24];

    xor.b64 %rd13, %rd10, %rd13;
    not.b64 %rd13, %rd13;
    popc.b64 %r9, %rd13;

    xor.b64 %rd14, %rd10, %rd14;
    not.b64 %rd14, %rd14;
    popc.b64 %r10, %rd14;

    xor.b64 %rd15, %rd10, %rd15;
    not.b64 %rd15, %rd15;
    popc.b64 %r11, %rd15;

    xor.b64 %rd16, %rd10, %rd16;
    not.b64 %rd16, %rd16;
    popc.b64 %r12, %rd16;

    shl.b32 %r10, %r10, 1;
    shl.b32 %r11, %r11, 2;
    shl.b32 %r12, %r12, 3;
    add.s32 %r13, %r9, %r10;
    add.s32 %r13, %r13, %r11;
    add.s32 %r13, %r13, %r12;
    shl.b32 %r13, %r13, 1;
    sub.s32 %r13, %r13, 960;

    cvt.rn.f32.s32 %f2, %r13;

    mul.wide.u32 %rd17, %r8, 4;
    add.u64 %rd18, %rd3, %rd17;
    ld.global.f32 %f3, [%rd18];

    mul.f32 %f4, %f3, 0f3D888889;
    fma.rn.f32 %f1, %f2, %f4, %f1;

    add.u32 %r8, %r8, 1;
    bra LOOP_B;

END_LOOP:
    mul.wide.u32 %rd19, %r6, 4;
    add.u64 %rd20, %rd4, %rd19;
    ld.global.f32 %f5, [%rd20];
    mul.f32 %f1, %f1, %f5;

    add.u64 %rd21, %rd5, %rd19;
    st.global.f32 [%rd21], %f1;

